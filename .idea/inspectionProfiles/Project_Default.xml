<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <option name="myName" value="Project Default" />

    <!-- 이 레포는 한국어로 쓴다(테스트 이름·주석·문구). 비ASCII 경고는 규칙 위반이 아니다. -->
    <inspection_tool class="NonAsciiCharacters" enabled="false" level="WARNING" enabled_by_default="false" />

    <!--
      좌변 타입 선언은 docs/coding-style.md 가 요구하는 것이라 이 검사만 끈다.
      우변 타입 인수(ArrayList<T>() 의 <T>)는 좌변이 이미 말하므로 중복이다 — 그 검사는 켜 두고 코드를 고쳤다.
    -->
    <inspection_tool class="RedundantExplicitType" enabled="false" level="WARNING" enabled_by_default="false" />

    <!-- 조건부 빈(RedisConfigured/RedisNotConfigured 등)이 후보를 여럿으로 보이게 해 오탐이 난다. -->
    <inspection_tool class="SpringJavaInjectionPointsAutowiringInspection" enabled="false" level="WARNING" enabled_by_default="false" />
  </profile>
</component>
