# bueongi 배포 환경변수 — .env 로 복사해 값을 채운다. (.env 는 커밋 금지)

# 사용자가 접속하는 공개 origin. 공유 링크(share_url)·CORS 허용에 쓰인다.
# tls 프로필 사용 시 https://<DOMAIN>, 로컬 확인 시 http://localhost:8080
PUBLIC_ORIGIN=http://localhost:8080

# 프론트 컨테이너의 호스트 포트(앞단 TLS 프록시가 있으면 그쪽에서 이 포트로 프록시)
HTTP_PORT=8080

# ---- 외부 API 키(없으면 폴백 동작: 경로=목업, 장소검색=시드) ----
TMAP_APP_KEY=
KAKAO_REST_API_KEY=
# 공공데이터포털(행안부 조회서비스) Encoding 키 — 있으면 CCTV·비상벨·여성안심지킴이집을 기동 시+매월 1일 04:00(KST) 라이브 갱신
DATA_GO_KR_SERVICE_KEY=
# 생활안전지도(safemap.go.kr) 인증키 — 있으면 치안시설(지구대·파출소·치안센터)을 같은 스케줄로 라이브 갱신
SAFEMAP_SERVICE_KEY=
# 재난안전데이터 공유 플랫폼(safetydata.go.kr) 인증키 — 있으면 가로등(공통POI DSSP-IF-00084)을 같은 스케줄로 라이브 갱신
SAFETYDATA_SERVICE_KEY=

# ---- 위치공유 저장소 ----
# 기본은 compose 의 redis 컨테이너. 외부 Redis 를 쓰면 여기서 덮어쓴다.
# BUEONGI_REDIS_URL=redis://redis:6379

# ---- 안심시설 저장소(PostgreSQL + PostGIS, compose 의 db) ----
# 필수. compose 가 db 컨테이너와 백엔드에 같은 값을 넣는다.
BUEONGI_DB_PASSWORD=

# ---- tls 프로필 사용 시(Let's Encrypt 자동 발급 — 80/443 개방 + DNS A 레코드 필요) ----
# DOMAIN=bueongi.example.com

# ---- 이미지 태그 고정(기본 latest) ----
# BACKEND_TAG=sha-abc1234
# FRONTEND_TAG=v1.0.0
