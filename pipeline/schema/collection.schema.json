{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bueongi.cdn/schema/collection.schema.json",
  "title": "CDN 컬렉션 파일",
  "description": "cctv/safehouse/police/lamp/emergency_bell/pedestrian_signal/safepath 의 *.json 공통 형태. 표준 아이템 배열을 메타로 감싼다.",
  "type": "object",
  "required": ["schemaVersion", "type", "generatedAt", "count", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": {
      "type": "string",
      "enum": ["cctv", "safehouse", "police", "lamp", "emergency_bell", "pedestrian_signal", "safepath"]
    },
    "scope": {
      "type": "string",
      "description": "all 또는 시군구코드(5자리) 또는 seoul",
      "examples": ["all", "seoul", "11110"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "이 파일에 기여한 원천 ID 목록"
    },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "cdn-item.schema.json" }
    }
  }
}
