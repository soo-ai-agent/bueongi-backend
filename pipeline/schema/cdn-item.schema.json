{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bueongi.cdn/schema/cdn-item.schema.json",
  "title": "표준 CDN 아이템",
  "description": "모든 CDN 산출물 배열의 단일 아이템 표준 스키마. 좌표는 항상 WGS84.",
  "type": "object",
  "required": ["id", "source", "type", "lat", "lng", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "원천+키 기반 결정적 ID" },
    "source": {
      "type": "string",
      "enum": ["A-4", "B-1", "C-1", "C-2", "C-3", "C-4"],
      "description": "대표 원천."
    },
    "type": {
      "type": "string",
      "enum": ["cctv", "lamp", "security_lamp", "pedestrian_signal", "safepath"]
    },
    "name": { "type": "string" },
    "address": { "type": "string" },
    "lat": { "type": "number", "minimum": 33.0, "maximum": 39.0, "description": "WGS84 위도 (대한민국 범위)" },
    "lng": { "type": "number", "minimum": 124.0, "maximum": 132.0, "description": "WGS84 경도 (대한민국 범위)" },
    "sigunguCode": { "type": "string", "pattern": "^[0-9]{5}$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "properties": {
      "type": "object",
      "description": "원천별 부가 속성.",
      "additionalProperties": true,
      "properties": {
        "phone": { "type": "string" },
        "coordOrigin": {
          "type": "string",
          "enum": ["wgs84", "epsg5179", "epsg5174", "per-district"],
          "description": "이 좌표가 어떤 변환 경로로 산출됐는지"
        }
      }
    }
  }
}
